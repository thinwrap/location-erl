%% Elvis lint policy. Defaults everywhere except the deviations below, each
%% with the reason it exists. Run with `rebar3 lint`.
[
    {config, [
        #{
            files => ["src/*.erl"],
            ruleset => erl_files,
            rules => [
                %% Closed vocabularies are atoms byte-identical to the sibling
                %% libraries' strings (`durationWithoutTraffic`, `privateBus`),
                %% so lowerCamel segments are allowed; anything else still fails.
                {elvis_style, atom_naming_convention, #{regex => "^[a-z][a-zA-Z0-9]*([_-][a-zA-Z0-9]+)*$"}},
                %% `throw` is the non-local return out of connector code, caught
                %% at the public boundary (`thinwrap_location:call/3`) — the use
                %% Elvis's own rationale names as legitimate. Only `fail/1` throws.
                {elvis_style, no_throw, #{ignore => [thinwrap_location_error, thinwrap_location_http]}},
                %% Behaviour dispatch: the transport callback and the
                %% provider-module dispatch are the two dynamic calls by design.
                {elvis_style, no_invalid_dynamic_calls, #{ignore => [thinwrap_location, thinwrap_location_http]}}
            ]
        },
        #{
            files => ["test/*.erl"],
            ruleset => erl_files_test,
            rules => [
                %% eunit generators are written `?_test(begin ... end)`.
                {elvis_style, no_block_expressions, disable},
                %% Test tables repeat structure on purpose; each row is a case.
                {elvis_style, dont_repeat_yourself, disable},
                %% Fixtures are vendor JSON bodies kept verbatim on one line.
                {elvis_text_style, max_line_length, disable},
                {elvis_style, atom_naming_convention, #{regex => "^[a-z][a-zA-Z0-9]*([_-][a-zA-Z0-9]+)*$"}},
                %% The fake transport implements a behaviour defined elsewhere.
                {elvis_style, no_invalid_dynamic_calls, disable}
            ]
        },
        #{files => ["rebar.config"], ruleset => rebar_config},
        #{files => [".gitignore"], ruleset => gitignore}
    ]},
    {output_format, plain}
].
